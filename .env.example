DATABASE_URL=sqlite:///./student_management.db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
APP_NAME=Student Management API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# Production example placeholders only:
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/student_management
# SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
# CORS_ORIGINS=https://your-domain.example

# Optional non-interactive bootstrap values:
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
USER_NAME=Staff User
USER_EMAIL=staff@example.com
USER_PASSWORD=replace-with-a-strong-password
USER_ROLE=staff
